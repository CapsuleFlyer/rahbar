diff --git a/k8s/eval-job.yaml b/k8s/eval-job.yaml
new file mode 100644
index 0000000..2963f91
--- /dev/null
+++ b/k8s/eval-job.yaml
@@ -0,0 +1,39 @@
+# The RAGOps test suite as a Kubernetes Job (part F2): kubectl apply -f k8s/eval-job.yaml
+# (or `make eval-suite`). It calls the API Service, writes eval/results files to the
+# eval-results volume, and prints the summary table to its log.
+# Re-run it: kubectl -n rahbar delete job eval-suite --ignore-not-found, then apply again.
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: eval-suite
+  namespace: rahbar
+  labels: {app.kubernetes.io/name: eval, app.kubernetes.io/part-of: rahbar}
+spec:
+  backoffLimit: 0
+  ttlSecondsAfterFinished: 86400
+  template:
+    metadata:
+      labels: {app.kubernetes.io/name: eval, app.kubernetes.io/part-of: rahbar}
+    spec:
+      restartPolicy: Never
+      serviceAccountName: rahbar-eval
+      automountServiceAccountToken: false
+      securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
+      containers:
+        - name: eval
+          image: rahbar-eval:dev
+          imagePullPolicy: IfNotPresent
+          args: ["python", "-m", "eval.suite", "--api", "http://api:8000", "--out", "/results", "--delay", "3", "--repeat", "2"]
+          envFrom:
+            - configMapRef: {name: rahbar-config}        # OLLAMA_URL, EMBED_MODEL, HOSTED_BASE_URL, LLM_MODEL
+            - secretRef: {name: rahbar-secret, optional: true}   # LLM_API_KEY: the faithfulness judge
+          securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
+          resources:
+            requests: {cpu: 50m, memory: 96Mi}
+            limits: {cpu: 500m, memory: 256Mi}
+          volumeMounts:
+            - {name: results, mountPath: /results}
+            - {name: tmp, mountPath: /tmp}
+      volumes:
+        - {name: results, persistentVolumeClaim: {claimName: eval-results}}
+        - {name: tmp, emptyDir: {}}
diff --git a/scripts/fetch-results.sh b/scripts/fetch-results.sh
new file mode 100755
index 0000000..cecc07c
--- /dev/null
+++ b/scripts/fetch-results.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+# Copy the test-suite result files from the eval-results volume into eval/results/.
+set -euo pipefail
+NS="${NS:-rahbar}"; NAME="results-$(date +%s)"; DEST="${1:-eval/results}"
+mkdir -p "$DEST"
+kubectl -n "$NS" apply -f - >/dev/null <<YAML
+apiVersion: v1
+kind: Pod
+metadata: {name: $NAME, namespace: $NS, labels: {app.kubernetes.io/name: eval, app.kubernetes.io/part-of: rahbar}}
+spec:
+  restartPolicy: Never
+  automountServiceAccountToken: false
+  securityContext: {runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: {type: RuntimeDefault}}
+  containers:
+    - name: copy
+      image: rahbar-eval:dev
+      imagePullPolicy: IfNotPresent
+      command: ["sleep", "120"]
+      securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
+      volumeMounts: [{name: results, mountPath: /results}]
+  volumes: [{name: results, persistentVolumeClaim: {claimName: eval-results}}]
+YAML
+kubectl -n "$NS" wait --for=condition=Ready "pod/$NAME" --timeout=90s >/dev/null
+kubectl -n "$NS" cp "$NAME:/results/." "$DEST"
+kubectl -n "$NS" delete pod "$NAME" --wait=false >/dev/null
+ls -l "$DEST"
